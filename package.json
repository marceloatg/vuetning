{
    "name": "vuetning",
    "version": "0.0.0",
    "description": "Vue 3 component library implementing the Salesforce Lightning Design System (SLDS).",
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "./dist/main.js",
    "module": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js"
        },
        "./styles": {
            "types": "./dist/styles.d.ts",
            "import": "./dist/styles.js"
        },
        "./resolver": {
            "types": "./dist/resolver.d.ts",
            "import": "./dist/resolver.js"
        },
        "./style.css": "./dist/assets/styles/main.css",
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.js"
        },
        "./components/types": {
            "types": "./dist/components/types.d.ts",
            "import": "./dist/components/types.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.js"
        },
        "./stencils": {
            "types": "./dist/stencils/index.d.ts",
            "import": "./dist/stencils/index.js"
        },
        "./stencils/*": {
            "types": "./dist/stencils/*/index.d.ts",
            "import": "./dist/stencils/*/index.js"
        },
        "./constants": {
            "types": "./dist/constants/index.d.ts",
            "import": "./dist/constants/index.js"
        },
        "./mixins/*": {
            "types": "./dist/mixins/*.d.ts",
            "import": "./dist/mixins/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src"
    ],
    "overrides": {
        "glob": "^13.0.6"
    },
    "scripts": {
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "build": "vite build && vue-tsc --emitDeclarationOnly",
        "build:analyze": "npm run build && open dist/bundle-analysis.html",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:ssr": "vitest run --config vitest.ssr.config.ts",
        "type-check": "vue-tsc --noEmit --composite false"
    },
    "dependencies": {
        "@formkit/auto-animate": "^0.9.0",
        "@vueuse/components": "^14.3.0",
        "@vueuse/core": "^14.3.0",
        "gsap": "^3.15.0",
        "moment": "^2.30.1",
        "numeral": "^2.0.6",
        "scrollparent": "^2.1.0",
        "uuid": "^14.0.0",
        "vue-observe-visibility": "^2.0.0-alpha.1"
    },
    "peerDependencies": {
        "vue": "^3.5.33"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.2",
        "@types/numeral": "^2.0.5",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/browser": "^4.1.8",
        "@vitest/browser-playwright": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.8",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/test-utils": "^2.4.11",
        "axe-core": "^4.12.0",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "glob": "^13.0.6",
        "globals": "^17.6.0",
        "playwright": "^1.60.0",
        "postcss": "^8.5.15",
        "postcss-prefix-selector": "^2.1.1",
        "rollup-plugin-visualizer": "^7.0.1",
        "sass": "^1.100.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-lib-inject-css": "^2.2.2",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.8",
        "vue": "^3.5.35",
        "vue-tsc": "^3.3.3"
    }
}
